# Required before public launch so users can contact the operator.
PUBLIC_CONTACT_EMAIL=

# SEO release switch. Keep false during private Preview. Set true only when public indexing is intentionally enabled.
PUBLIC_SITE_INDEXABLE=false
PUBLIC_SITE_URL=https://oshiruoshi.vercel.app

# Yahoo! Shopping official API
YAHOO_CLIENT_ID=

# Rakuten Ichiba official API (2026-07-01)
RAKUTEN_APP_ID=
RAKUTEN_ACCESS_KEY=
RAKUTEN_AFFILIATE_ID=
RAKUTEN_ICHIBA_ENDPOINT=https://openapi.rakuten.co.jp/ichibams/api/IchibaItem/Search/20260701

# Amazon Creators API. Requires an approved Amazon Associates account and eligible Creators API credentials.
AMAZON_CREATORS_CLIENT_ID=
AMAZON_CREATORS_CLIENT_SECRET=
AMAZON_PARTNER_TAG=
AMAZON_MARKETPLACE=www.amazon.co.jp
AMAZON_TOKEN_ENDPOINT=https://api.amazon.co.jp/auth/o2/token
AMAZON_CREATORS_API_ENDPOINT=https://creatorsapi.amazon

# Web discovery for marketplaces without a general public item-search API.
# Brave Search is preferred. General terms allow transient operational storage only;
# persistent storage of Search Results requires explicit storage rights from Brave.
BRAVE_SEARCH_API_KEY=

# Optional fallback for marketplace discovery when Brave is not configured or its request fails.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_SEARCH_MODEL=

# Optional X search
X_BEARER_TOKEN=

# Safety default: keep direct public-page adapters disabled unless each source's terms/permission are reviewed.
ENABLE_PUBLIC_PAGE_ADAPTERS=false
